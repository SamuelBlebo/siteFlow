{
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "src",
        "*.log",
        "build.mjs",
        "tsconfig.json"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 19099
    },
    "firestore": {
      "port": 18080
    },
    "functions": {
      "port": 15001
    },
    "storage": {
      "port": 19199
    },
    "hub": {
      "port": 14400
    },
    "logging": {
      "port": 14500
    },
    "ui": {
      "enabled": false
    }
  }
}
