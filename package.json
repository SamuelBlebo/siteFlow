{
  "name": "siteflow",
  "private": true,
  "description": "SiteFlow monorepo: web app, mobile app, shared package and Firebase backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix firebase/functions install",
    "dev:web": "npm run dev -w @siteflow/web",
    "dev:mobile": "npm run start -w @siteflow/mobile",
    "build:web": "npm run build -w @siteflow/web",
    "build:functions": "npm --prefix firebase/functions run build",
    "typecheck": "npm run typecheck -w @siteflow/shared && npm --prefix firebase/functions run typecheck && tsc -p firebase/tests --noEmit",
    "emulators": "firebase emulators:start --project demo-siteflow",
    "deploy:dev": "firebase deploy --project dev",
    "deploy:prod": "firebase deploy --project prod",
    "deploy:rules": "firebase deploy --only firestore,storage --project dev",
    "test": "npm run test:shared && npm run test:rules && npm run test:functions && npm run test:web",
    "test:shared": "npm test -w @siteflow/shared",
    "test:rules": "node scripts/test-emulators.mjs firestore,storage \"vitest run --config firebase/tests/vitest.config.ts\"",
    "test:web": "npm run build:functions && node scripts/test-emulators.mjs auth,firestore,storage,functions \"npm run test:integration -w @siteflow/web\"",
    "test:functions": "node scripts/test-emulators.mjs firestore \"vitest run --config firebase/functions/vitest.config.ts\"",
    "coverage": "npm run test:shared -- --coverage && npm test -w @siteflow/mobile -- --coverage --coverage.include=src/lib/**",
    "config:dev": "node scripts/fetch-firebase-config.mjs dev",
    "config:prod": "node scripts/fetch-firebase-config.mjs prod",
    "check:env": "node scripts/check-env.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
