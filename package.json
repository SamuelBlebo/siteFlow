{
  "name": "siteflow",
  "private": true,
  "description": "SiteFlow monorepo: web app, mobile app, shared package and Firebase backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "pnpm install && npm --prefix firebase/functions install",
    "dev:web": "pnpm --filter @siteflow/web dev",
    "dev:mobile": "pnpm --filter @siteflow/mobile start",
    "build:web": "pnpm --filter @siteflow/web build",
    "build:functions": "npm --prefix firebase/functions run build",
    "typecheck": "pnpm --filter @siteflow/shared typecheck && npm --prefix firebase/functions run typecheck && tsc -p firebase/tests --noEmit",
    "emulators": "firebase emulators:start --project demo-siteflow",
    "deploy:dev": "firebase deploy --project dev",
    "deploy:prod": "firebase deploy --project prod",
    "deploy:rules": "firebase deploy --only firestore,storage --project dev",
    "test": "pnpm run test:shared && pnpm run test:rules && pnpm run test:functions && pnpm run test:web",
    "test:shared": "pnpm --filter @siteflow/shared test",
    "test:rules": "node scripts/test-emulators.mjs firestore,storage \"vitest run --config firebase/tests/vitest.config.ts\"",
    "test:web": "pnpm run build:functions && node scripts/test-emulators.mjs auth,firestore,storage,functions \"pnpm --filter @siteflow/web test:integration\"",
    "test:functions": "node scripts/test-emulators.mjs auth,firestore \"vitest run --config firebase/functions/vitest.config.ts\"",
    "coverage": "pnpm run test:shared --coverage && pnpm --filter @siteflow/mobile test --coverage --coverage.include=src/lib/**",
    "config:dev": "node scripts/fetch-firebase-config.mjs dev",
    "config:prod": "node scripts/fetch-firebase-config.mjs prod",
    "check:env": "node scripts/check-env.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.22.0"
}
