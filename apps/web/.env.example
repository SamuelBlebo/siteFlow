# Copy to .env.development (siteflow-dev) and .env.production (siteflow-prod).
# Values: Firebase console > Project settings > Your apps > Web app
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# Set to true to use the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false
