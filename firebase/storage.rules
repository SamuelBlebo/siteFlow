rules_version = '2';

// Role lists mirror packages/shared/src/permissions.ts. Tested in firebase/tests/storage.rules.test.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function member(cid) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().companyId == cid && profile().get('active', true) != false;
    }
    function onSite(cid, sid) {
      return member(cid) && (profile().role in ['owner', 'admin', 'manager', 'finance'] || sid in profile().siteIds);
    }
    function siteWork(cid, sid) { return onSite(cid, sid) && profile().role in ['owner', 'admin', 'manager', 'supervisor']; }
    function siteManager(cid) { return member(cid) && profile().role in ['owner', 'admin', 'manager']; }

    // Daily report photos: paths.photo(cid, sid, reportId, file)
    match /companies/{cid}/sites/{sid}/reports/{reportId}/{file} {
      allow read: if onSite(cid, sid);
      // New files only (no overwriting someone else's photo), images under 10 MB
      allow create: if resource == null && siteWork(cid, sid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // Anything else is closed until a feature needs it
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
