rules_version = '2';

// Role lists mirror packages/shared/src/permissions.ts. Tested in firebase/tests/storage.rules.test.ts.
service firebase.storage {
  match /b/{bucket}/o {
    // The person's role, projects and switch in this company (companies/{cid}/members/{uid})
    function memberPath(cid) { return /databases/(default)/documents/companies/$(cid)/members/$(request.auth.uid); }
    function profile(cid) { return firestore.get(memberPath(cid)).data; }
    function member(cid) {
      return request.auth != null && firestore.exists(memberPath(cid)) && profile(cid).get('active', true) != false;
    }
    function onSite(cid, sid) {
      return member(cid) && (profile(cid).role in ['owner', 'admin', 'manager', 'finance'] || sid in profile(cid).siteIds);
    }
    function siteOpen(cid, sid) { return firestore.get(/databases/(default)/documents/companies/$(cid)/sites/$(sid)).data.status != 'closed'; }
    function siteWork(cid, sid) {
      return onSite(cid, sid) && profile(cid).role in ['owner', 'admin', 'manager', 'supervisor'] && siteOpen(cid, sid);
    }
    function siteManager(cid) { return member(cid) && profile(cid).role in ['owner', 'admin', 'manager']; }

    // Daily report photos: paths.photo(cid, sid, reportId, file)
    match /companies/{cid}/sites/{sid}/reports/{reportId}/{file} {
      allow read: if onSite(cid, sid);
      // New files only (no overwriting someone else's photo), images under 10 MB
      allow create: if resource == null && siteWork(cid, sid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // Issue photos: paths.issuePhoto(cid, sid, issueId, file)
    match /companies/{cid}/sites/{sid}/issues/{issueId}/{file} {
      allow read: if onSite(cid, sid);
      allow create: if resource == null && siteWork(cid, sid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // Project image (visualization or photo): paths.coverFile. Managers upload; images under 10 MB.
    match /companies/{cid}/sites/{sid}/cover/{file} {
      allow read: if onSite(cid, sid);
      allow create: if resource == null && siteManager(cid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // Project drawings: paths.drawingFile(cid, sid, drawingId, file). The original PDF or image and
    // the picture shown (page 1 of a PDF). Uploaded by owners, admins and project managers.
    match /companies/{cid}/sites/{sid}/drawings/{drawingId}/{file} {
      allow read: if onSite(cid, sid);
      allow create: if resource == null && siteManager(cid)
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)|application/pdf');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // The architect's 3D model: paths.modelFile. IFC (no reliable content type) or GLB / glTF,
    // up to 100 MB. Uploaded by owners, admins and project managers; a new one replaces the old.
    match /companies/{cid}/sites/{sid}/model/{file} {
      allow read: if onSite(cid, sid);
      allow create: if resource == null && siteManager(cid)
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('application/octet-stream|model/gltf-binary|model/gltf[+]json');
      allow update: if false;
      allow delete: if siteManager(cid);
    }

    // Anything else is closed until a feature needs it
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
