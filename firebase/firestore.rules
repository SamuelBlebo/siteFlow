rules_version = '2';

// Role lists mirror packages/shared/src/permissions.ts (PERMISSIONS).
// firebase/tests/firestore.rules.test.ts checks every role against that table.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(myPath()).data; }
    // Member of this company, and not switched off
    function member(cid) {
      return signedIn() && exists(myPath()) && me().companyId == cid && me().get('active', true) != false;
    }
    function hasRole(cid, roles) { return member(cid) && me().role in roles; }

    // ---------- permissions (see PERMISSIONS in shared) ----------
    function companySettings(cid) { return hasRole(cid, ['owner']); }
    function teamManager(cid) { return hasRole(cid, ['owner', 'admin']); }
    function allSites(cid) { return hasRole(cid, ['owner', 'admin', 'manager', 'finance']); }
    function siteManager(cid) { return hasRole(cid, ['owner', 'admin', 'manager']); }
    function financeView(cid) { return hasRole(cid, ['owner', 'admin', 'manager', 'finance']); }
    function financeEdit(cid) { return hasRole(cid, ['owner', 'admin', 'manager', 'finance']); }
    function auditView(cid) { return hasRole(cid, ['owner', 'admin']); }

    function onSite(cid, sid) { return allSites(cid) || (member(cid) && sid in me().siteIds); }
    // Closed sites are read-only for daily work
    function siteOpen(cid, sid) { return get(sitePath(cid, sid)).data.status != 'closed'; }
    // Daily site work: reports, attendance, material logs, adding workers
    function siteWork(cid, sid) {
      return onSite(cid, sid) && me().role in ['owner', 'admin', 'manager', 'supervisor'] && siteOpen(cid, sid);
    }

    // ---------- helpers ----------
    function data() { return request.resource.data; }
    function onlyChanges(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
    function byMe() { return data().createdBy == request.auth.uid; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optText(field, max) { return !(field in data()) || isText(data()[field], 0, max); }
    // Small copies of photos (optional; older records have none), at most one per photo
    function validThumbs() { return !('thumbs' in data()) || (data().thumbs is list && data().thumbs.size() <= 8); }
    function isNum(v) { return v is int || v is float; }
    function isAmount(v) { return isNum(v) && v >= 0; }
    function isPct(v) { return (v is int || v is float) && v >= 0 && v <= 100; }
    function isDateKey(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(field) { return !(field in data()) || data()[field] == null || isDateKey(data()[field]); }
    function sitePath(cid, sid) { return /databases/$(database)/documents/companies/$(cid)/sites/$(sid); }

    // ---------- users ----------
    // Profiles are created and changed only by Cloud Functions (createCompany, inviteMember,
    // updateMember, setMemberActive, resetMemberPassword, removeMember), which check the role
    // rules and write the audit trail. People may edit their own name and phone, and clear
    // the "must change password" flag after setting a new password.
    match /users/{uid} {
      // Project managers also see the team, to assign people to their sites
      allow read: if signedIn() && (request.auth.uid == uid || teamManager(resource.data.companyId) || siteManager(resource.data.companyId));
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid && member(resource.data.companyId)
        && onlyChanges(['name', 'phone', 'mustChangePassword', 'updatedAt'])
        && isText(data().name, 2, 100) && optText('phone', 20)
        && data().get('mustChangePassword', false) == false;
    }

    // Company-wide reports page: one collection-group query, filtered by companyId
    match /{path=**}/reports/{rid} {
      allow read: if signedIn() && allSites(resource.data.companyId);
    }

    // Company-wide issues page: one collection-group query, filtered by companyId
    match /{path=**}/issues/{iid} {
      allow read: if signedIn() && allSites(resource.data.companyId);
    }

    // ---------- companies ----------
    match /companies/{cid} {
      allow read: if member(cid);
      // Created by the createCompany function. plan and modules are set by the server only.
      allow create, delete: if false;
      // country, currency and time zone: the owner's local settings (codes checked in the app; shape checked here)
      allow update: if companySettings(cid) && onlyChanges(['name', 'phone', 'location', 'notifications', 'country', 'currency', 'timeZone', 'updatedAt'])
        && isText(data().name, 2, 100) && optText('phone', 20) && optText('location', 200)
        && (!('notifications' in data()) || (data().notifications is map && data().notifications.size() <= 20))
        && (!('country' in data()) || (data().country is string && data().country.matches('^[A-Z]{2}$')))
        && (!('currency' in data()) || (data().currency is string && data().currency.matches('^[A-Z]{3}$')))
        && (!('timeZone' in data()) || (data().timeZone is string && data().timeZone.matches('^[A-Za-z_+-]+(/[A-Za-z0-9_+-]+){0,2}$')));

      match /equipment/{id} {
        allow read: if member(cid);
        allow write: if siteManager(cid);
      }
      // Messages sent (WhatsApp, email): written by Cloud Functions only, read by owners and admins
      match /notifications/{id} {
        allow read: if teamManager(cid);
        allow write: if false;
      }
      // Audit trail: written by Cloud Functions only
      match /activity/{id} {
        allow read: if auditView(cid);
        allow write: if false;
      }

      // ---------- sites ----------
      match /sites/{sid} {
        function siteKeys() {
          return ['name', 'location', 'foremanName', 'foremanPhone', 'foremanEmail', 'stage', 'progress', 'status',
                  'lastReportDate', 'lastReportTime', 'planStart', 'planEnd', 'client', 'createdAt', 'updatedAt'];
        }
        function validSite() {
          return data().keys().hasOnly(siteKeys())
            && isText(data().name, 2, 120) && isText(data().location, 2, 200)
            && isText(data().stage, 1, 60) && isPct(data().progress)
            && data().status in ['active', 'on_hold', 'closed']
            && optText('foremanName', 100) && optText('foremanPhone', 20) && optText('foremanEmail', 200)
            && optDate('planStart') && optDate('planEnd')
            && (!('client' in data()) || data().client == null
                || (data().client is map && data().client.keys().hasOnly(['name', 'phone', 'email']) && isText(data().client.name, 1, 120)));
        }

        allow read: if onSite(cid, sid);
        allow create: if siteManager(cid) && validSite();
        // Sites are closed, never deleted, so their history stays
        allow delete: if false;
        // Site managers edit anything. The site team only moves stage/progress and marks the report sent.
        allow update: if (siteManager(cid) && validSite())
          || (siteWork(cid, sid)
              && onlyChanges(['stage', 'progress', 'lastReportDate', 'lastReportTime'])
              && isPct(data().progress) && isText(data().stage, 1, 60)
              && (data().lastReportDate == null || isDateKey(data().lastReportDate)) && optText('lastReportTime', 5));

        // Money for this site: finance roles only. Budget is set by site managers.
        // Money for this site: finance roles only. Site managers set the budget (total and per category).
        // spent, byCategory and expenseCount are written only by the recalcSiteSpending function.
        match /finance/{docId} {
          function validBudget() {
            return isAmount(data().budget)
              && (!('budgetByCategory' in data()) || (data().budgetByCategory is map && data().budgetByCategory.size() <= 20));
          }
          allow read: if financeView(cid);
          allow create: if siteManager(cid) && docId == 'summary'
            && data().keys().hasOnly(['budget', 'budgetByCategory', 'spent', 'updatedAt'])
            && validBudget() && data().spent == 0;
          allow update: if siteManager(cid) && docId == 'summary'
            && onlyChanges(['budget', 'budgetByCategory', 'updatedAt']) && validBudget();
          allow delete: if false;
        }

        match /materials/{id} {
          function validMaterial() {
            return data().keys().hasOnly(['name', 'unit', 'stock', 'reorderLevel', 'avgDaily', 'active', 'lastLogId', 'createdAt', 'updatedAt'])
              && isText(data().name, 1, 120) && isText(data().unit, 1, 20)
              && isNum(data().stock) && isAmount(data().reorderLevel) && isAmount(data().avgDaily)
              && (!('active' in data()) || data().active is bool);
          }
          function stockMovement() {
            let logPath = /databases/$(database)/documents/companies/$(cid)/sites/$(sid)/materialLogs/$(data().lastLogId);
            let log = getAfter(logPath).data;
            return onlyChanges(['stock', 'lastLogId'])
              && !exists(logPath)
              && log.materialId == id && log.createdBy == request.auth.uid
              && data().stock == resource.data.stock + (log.type == 'usage' ? -log.qty : log.qty);
          }
          allow read: if onSite(cid, sid);
          allow create: if siteManager(cid) && validMaterial() && isAmount(data().stock) && data().get('active', true) == true;
          allow delete: if false; // archive instead (active: false), so entries keep their material
          allow update: if (siteManager(cid) && validMaterial() && !data().diff(resource.data).affectedKeys().hasAny(['stock', 'lastLogId']))
            || (siteWork(cid, sid) && stockMovement());
        }

        // A permanent record: entries are never edited or deleted (a stock count corrects the balance).
        match /materialLogs/{id} {
          allow read: if onSite(cid, sid);
          allow create: if siteWork(cid, sid) && byMe()
            && data().keys().hasOnly(['materialId', 'materialName', 'unit', 'type', 'qty', 'cost', 'supplier', 'ref', 'note',
                                      'date', 'createdBy', 'createdByName', 'createdAt'])
            && data().type in ['usage', 'delivery', 'adjustment']
            && isNum(data().qty)
            && (data().type == 'adjustment'
                ? (data().qty != 0 && siteManager(cid) && isText(data().note, 3, 500))
                : data().qty > 0)
            // Delivery cost is a money figure: finance roles only, deliveries only
            && isAmount(data().cost) && (data().cost == 0 || (financeEdit(cid) && data().type == 'delivery'))
            && isDateKey(data().date) && optText('supplier', 120) && optText('ref', 60) && optText('note', 500)
            && data().createdByName == me().name
            && getAfter(/databases/$(database)/documents/companies/$(cid)/sites/$(sid)/materials/$(data().materialId)).data.lastLogId == id;
          allow update, delete: if false;
        }

        // Expenses: finance roles record, correct and delete them; totals follow on the server
        match /expenses/{id} {
          function validExpense() {
            return data().keys().hasOnly(['date', 'category', 'note', 'amount', 'payee', 'method', 'ref', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
              && isAmount(data().amount) && data().amount > 0 && data().amount <= 100000000
              && isText(data().category, 1, 60) && optText('note', 500) && optText('payee', 120) && optText('method', 40) && optText('ref', 60)
              && isDateKey(data().date);
          }
          allow read: if financeView(cid);
          allow create: if financeEdit(cid) && byMe() && validExpense() && data().createdByName == me().name;
          allow update: if financeEdit(cid) && validExpense() && !data().diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdByName', 'createdAt']);
          allow delete: if financeEdit(cid);
        }

        // Worker names and trades are visible to the site team; pay is not.
        match /workers/{id} {
          function validWorker() {
            return data().keys().hasOnly(['name', 'trade', 'phone', 'active', 'createdBy', 'createdAt', 'updatedAt'])
              && isText(data().name, 2, 100) && isText(data().trade, 1, 60) && optText('phone', 20) && data().active is bool;
          }
          allow read: if onSite(cid, sid);
          allow create: if siteWork(cid, sid) && byMe() && validWorker() && data().active == true;
          // The site team fixes names, trades and phones; switching a worker off is for site managers
          allow update: if validWorker()
            && (siteManager(cid) || (siteWork(cid, sid) && onlyChanges(['name', 'trade', 'phone', 'updatedAt'])));
          allow delete: if siteManager(cid);
        }
        match /workerPay/{id} {
          allow read: if financeView(cid);
          allow create, update: if financeEdit(cid)
            && data().keys().hasOnly(['dailyRate', 'bankName', 'accountLast4', 'updatedAt'])
            && isAmount(data().dailyRate) && optText('bankName', 60)
            && (!('accountLast4' in data()) || data().accountLast4.matches('^[0-9]{0,4}$'));
          allow delete: if financeEdit(cid);
        }

        // One doc per day: { date, marks: { workerId: 'present' | 'late' | 'absent' | 'leave' }, markedBy }.
        // Apps merge one worker at a time, so two phones marking different workers never clash.
        match /attendance/{date} {
          allow read: if onSite(cid, sid);
          allow create, update: if siteWork(cid, sid)
            && data().keys().hasOnly(['date', 'marks', 'markedBy', 'updatedAt'])
            && data().date == date && isDateKey(date)
            && data().marks is map && data().marks.size() <= 500
            && data().marks.values().hasOnly(['present', 'late', 'absent', 'leave'])
            && data().markedBy == request.auth.uid;
          allow delete: if siteManager(cid);
        }

        // One report per person per day: id = {date}_{uid} (reportId in shared). The document names its
        // own company and site so the company-wide reports page can query all reports at once.
        match /reports/{id} {
          function validReport() {
            return data().keys().hasOnly(['companyId', 'siteId', 'siteName', 'date', 'time', 'text', 'notes', 'issues', 'weather',
                                          'stage', 'progress', 'workersPresent', 'materialsUsed', 'photos', 'thumbs', 'photoCount',
                                          'createdBy', 'createdByName', 'source', 'createdAt'])
              && data().companyId == cid && data().siteId == sid && isText(data().siteName, 1, 120)
              && isDateKey(data().date) && id == data().date + '_' + request.auth.uid
              && isText(data().time, 4, 5)
              && isText(data().text, 1, 5000) && optText('notes', 5000) && optText('issues', 5000)
              && (!('weather' in data()) || data().weather in ['', 'Sunny', 'Cloudy', 'Light rain', 'Heavy rain', 'Windy'])
              && isText(data().stage, 1, 60) && isPct(data().progress)
              && data().workersPresent is int && data().workersPresent >= 0 && data().workersPresent <= 2000
              && (!('materialsUsed' in data()) || (data().materialsUsed is list && data().materialsUsed.size() <= 100))
              && data().photos is list && data().photos.size() <= 8 && validThumbs()
              && (!('photoCount' in data()) || (data().photoCount is int && data().photoCount >= 0 && data().photoCount <= 8))
              && data().source in ['app', 'web']
              && data().createdByName == me().name;
          }
          allow read: if onSite(cid, sid);
          allow create: if siteWork(cid, sid) && byMe() && validReport();
          // Reports are a record: the author may only add photo links as they finish uploading
          allow update: if siteWork(cid, sid) && resource.data.createdBy == request.auth.uid
            && onlyChanges(['photos', 'thumbs', 'photoCount']) && data().photos is list && data().photos.size() <= 8 && validThumbs();
          allow delete: if siteManager(cid);
        }

        // Milestones: site managers set them up; the site team updates progress (with their name).
        match /milestones/{id} {
          function validMilestone() {
            return data().keys().hasOnly(['name', 'order', 'weight', 'plannedStart', 'plannedEnd', 'status', 'percentDone',
                                          'actualStart', 'actualEnd', 'note', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'])
              && isText(data().name, 1, 100) && data().order is int
              && (!('weight' in data()) || (isNum(data().weight) && data().weight > 0 && data().weight <= 1000))
              && optDate('plannedStart') && optDate('plannedEnd') && optDate('actualStart') && optDate('actualEnd')
              && data().status in ['not_started', 'in_progress', 'done'] && isPct(data().percentDone)
              && (data().status != 'done' || data().percentDone == 100)
              && (data().status != 'not_started' || data().percentDone == 0)
              && optText('note', 500);
          }
          allow read: if onSite(cid, sid);
          allow create: if siteManager(cid) && validMilestone();
          allow delete: if siteManager(cid);
          allow update: if validMilestone() && (siteManager(cid)
            || (siteWork(cid, sid)
                && onlyChanges(['status', 'percentDone', 'actualStart', 'actualEnd', 'note', 'updatedBy', 'updatedByName', 'updatedAt'])
                && data().updatedBy == request.auth.uid && data().updatedByName == me().name));
        }

        // Problems reported on site. Mirrors issueActions in shared:
        //  site managers do anything; the assignee starts and resolves; the reporter edits details
        //  while it is open; anyone doing site work comments. Issues are never deleted.
        match /issues/{id} {
          function issueKeys() {
            return ['companyId', 'siteId', 'siteName', 'title', 'description', 'priority', 'category', 'location', 'date', 'dueDate',
                    'status', 'assignedTo', 'assignedToName', 'photos', 'thumbs', 'photoCount', 'resolution', 'resolvedBy', 'resolvedByName',
                    'resolvedAt', 'commentCount', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'lastActivityAt'];
          }
          function validIssue() {
            return data().keys().hasOnly(issueKeys())
              && data().companyId == cid && data().siteId == sid && isText(data().siteName, 1, 120)
              && isText(data().title, 3, 120) && optText('description', 5000) && optText('location', 120)
              && data().priority in ['critical', 'high', 'medium', 'low'] && isText(data().category, 1, 60)
              && isDateKey(data().date) && (data().dueDate == null || isDateKey(data().dueDate))
              && data().status in ['open', 'in_progress', 'resolved', 'closed']
              && (data().assignedTo == null || data().assignedTo is string) && optText('assignedToName', 100)
              && data().photos is list && data().photos.size() <= 8 && validThumbs() && data().photoCount is int
              && optText('resolution', 2000) && data().commentCount is int && data().commentCount >= 0
              && (data().status != 'resolved' || isText(data().resolution, 3, 2000));
          }
          function changed(keys) { return data().diff(resource.data).affectedKeys().hasAny(keys); }
          function only(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
          // The person given the issue must belong to this company
          function validAssignee() {
            return data().assignedTo == null || get(/databases/$(database)/documents/users/$(data().assignedTo)).data.companyId == cid;
          }
          // Whoever marks it resolved is recorded as the resolver
          function resolverIsMe() {
            return !(changed(['status']) && data().status == 'resolved')
              || (data().resolvedBy == request.auth.uid && data().resolvedByName == me().name);
          }
          function assigneeStep() {
            return resource.data.assignedTo == request.auth.uid
              && only(['status', 'resolution', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'updatedAt', 'lastActivityAt'])
              && ((resource.data.status == 'open' && data().status == 'in_progress')
                  || (resource.data.status in ['open', 'in_progress'] && data().status == 'resolved'));
          }
          function reporterEdit() {
            return resource.data.createdBy == request.auth.uid && resource.data.status == 'open'
              && only(['title', 'description', 'location', 'category', 'photos', 'thumbs', 'photoCount', 'updatedAt', 'lastActivityAt']);
          }
          function commentBump() {
            return only(['commentCount', 'lastActivityAt']) && data().commentCount == resource.data.commentCount + 1;
          }

          allow read: if onSite(cid, sid);
          allow create: if siteWork(cid, sid) && byMe() && validIssue()
            && data().status == 'open' && data().commentCount == 0 && data().resolution == '' && data().resolvedBy == null
            && data().createdByName == me().name
            && (data().assignedTo == null || (siteManager(cid) && validAssignee()));
          allow update: if siteWork(cid, sid) && validIssue()
            && !changed(['companyId', 'siteId', 'siteName', 'date', 'createdBy', 'createdByName', 'createdAt'])
            && (!changed(['assignedTo']) || validAssignee())
            && resolverIsMe()
            && (siteManager(cid) || assigneeStep() || reporterEdit() || commentBump());
          allow delete: if false;

          // Comments and change notes: permanent, by the site team
          match /comments/{commentId} {
            allow read: if onSite(cid, sid);
            allow create: if siteWork(cid, sid) && byMe()
              && data().keys().hasOnly(['text', 'kind', 'createdBy', 'createdByName', 'createdAt'])
              && isText(data().text, 1, 2000) && data().kind in ['comment', 'update']
              && data().createdByName == me().name;
            allow update, delete: if false;
          }
        }

        // Future modules. Money-bearing collections are finance-only.
        match /{coll}/{id} {
          function moduleColl() {
            return coll in ['rfis', 'inspections', 'punchItems', 'incidents', 'toolboxTalks', 'tasks', 'drawings', 'documents'];
          }
          function moneyColl() { return coll in ['changeOrders', 'subcontractors', 'billing']; }
          allow read: if (moduleColl() && onSite(cid, sid)) || (moneyColl() && financeView(cid));
          allow create: if byMe() && ((moduleColl() && siteWork(cid, sid)) || (moneyColl() && financeEdit(cid)));
          allow update: if (moduleColl() || moneyColl())
            && (siteManager(cid)
                || (siteWork(cid, sid) && coll in ['punchItems', 'inspections'] && onlyChanges(['status', 'items', 'photo'])));
          allow delete: if siteManager(cid) && (moduleColl() || moneyColl());
        }
      }
    }
  }
}
